<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- EMPLOYEE - AOR EDGE AND NEGATIVE CASES. One test class = one report folder (reports/AorBulkUploadAndPayeeSheetEdgeCases/<run>).
     TC-AOR-EDGE-01 = bulk upload of employees (wrong / missing / duplicate data), TC-AOR-EDGE-02 = Payee Sheet (payroll calculation) for the same employees.
     No employee limit (user, 2026-11-11); -Daor.edge.sessions.max (default 100) payroll sessions. AorListScreensEdgeCases (own report folder): search, tabs, filters, paging, sort, columns and dates of the AOR Agents, Payroll and Invoices lists (read-only).
     The files "...EdgeCases.xlsx" in the folder of the QA owner are filled and replaced on every run; the originals are never changed.
     Run:  mvn clean test -Dsuite=testng-aor-edge-cases.xml
     One case only:  add -Dcases=TC-AOR-EDGE-01 (TC-AOR-EDGE-02 on the employees of an earlier run: -Daor.edge.run.data=reports/AorBulkUploadAndPayeeSheetEdgeCases/&lt;run folder&gt;/aor-edge-run-data.json) -->
<suite name="KOMP IND Testing - Employee AOR edge cases" verbose="1" parallel="none">
    <test name="AOR Employee edge and negative cases">
        <classes>
            <class name="tests.employee.aor.AorBulkUploadAndPayeeSheetEdgeCases"/>
            <class name="tests.employee.aor.AorListScreensEdgeCases"/>
        </classes>
    </test>
</suite>
