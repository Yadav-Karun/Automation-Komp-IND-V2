<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- EMPLOYEE - AOR LIST SCREENS ONLY (read-only): search, tabs, filters, paging, sort, columns and dates of the AOR Agents, AOR Payroll and AOR Invoices lists.
     The same class is also part of testng-aor-edge-cases.xml; this suite runs it alone (about 25 minutes, creates nothing).
     Run:  mvn clean test -Dsuite=testng-aor-list-screens.xml -->
<suite name="KOMP IND Testing - AOR list screens" verbose="1" parallel="none">
    <test name="AOR list screens (search, filter, paging, sort, columns)">
        <classes>
            <class name="tests.employee.aor.AorListScreensEdgeCases"/>
        </classes>
    </test>
</suite>
